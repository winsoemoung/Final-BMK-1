rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCargo(data) {
      return data.trackingNumber is string &&
             data.senderName is string &&
             data.receiverName is string;
    }

    function isValidTruck(data) {
      return data.truckNumber is string &&
             data.driverName is string;
    }

    match /users/{userId}/cargos/{cargoId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/trucks/{truckId} {
      allow read, write: if isOwner(userId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
